{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/inventory/types/item.json",
  "title": "Catalog Item",
  "description": "A canonical menu item with modifier group references.",
  "type": "object",
  "required": ["id", "name", "description", "price"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Item identifier."
    },
    "name": {
      "type": "string",
      "description": "Item name."
    },
    "description": {
      "type": "object",
      "description": "Item description in one or more formats. At least one format must be provided.",
      "properties": {
        "plain": {
          "type": "string",
          "description": "Plain text description."
        },
        "html": {
          "type": "string",
          "description": "HTML-formatted description."
        },
        "markdown": {
          "type": "string",
          "description": "Markdown-formatted description."
        }
      },
      "minProperties": 1
    },
    "price": {
      "$ref": "https://localprotocol.xyz/schemas/ucp/types/price.json",
      "description": "Base price for the item."
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "https://localprotocol.xyz/schemas/ucp/types/media.json"
      },
      "description": "Item media (images, videos, 3D models)."
    },
    "modifier_group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Modifier group identifiers available for this item."
    },
    "modifier_group_overrides": {
      "type": "array",
      "items": {
        "$ref": "modifier_group_override.json"
      },
      "description": "Item-level overrides for modifier groups (selection constraints, quantities, and option ordering/availability)."
    },
    "availability": {
      "$ref": "availability.json",
      "description": "Item availability. Ignored when the catalog or category defines availability."
    },
    "metadata": {
      "type": "object",
      "description": "Business-defined custom data extending the item.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
