{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/inventory/types/category.json",
  "title": "Catalog Category",
  "description": "A canonical category grouping items in a catalog.",
  "type": "object",
  "required": ["id", "name", "item_ids"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Category identifier."
    },
    "name": {
      "type": "string",
      "description": "Category display name."
    },
    "description": {
      "type": "string",
      "description": "Optional category description."
    },
    "parent_category_id": {
      "type": "string",
      "description": "Optional parent category identifier for nested category trees."
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of item identifiers in this category."
    },
    "metadata": {
      "type": "object",
      "description": "Business-defined custom data extending the category.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
