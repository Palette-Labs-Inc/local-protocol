{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/inventory/catalog.json",
  "title": "Catalog",
  "description": "A catalog containing categories, items, and fulfillment configuration.",
  "type": "object",
  "required": ["id", "name", "category_ids"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Catalog identifier."
    },
    "name": {
      "type": "string",
      "description": "Catalog name."
    },
    "description": {
      "type": "string",
      "description": "Catalog description."
    },
    "category_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Category identifiers included in this catalog."
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item identifiers included in this catalog that are not assigned to a category."
    },
    "fulfillment_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fulfillment modes supported by this catalog."
    },
    "menu_view_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Menu view identifiers associated with this catalog."
    },
    "external_ids": {
      "type": "array",
      "items": {
        "$ref": "types/external_id.json"
      },
      "description": "Provider identifiers for this catalog."
    },
    "metadata": {
      "type": "object",
      "description": "Business-defined custom data extending the catalog.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
