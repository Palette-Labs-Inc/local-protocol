{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinates",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Latitude in decimal degrees."
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Longitude in decimal degrees."
    }
  },
  "required": [
    "latitude",
    "longitude"
  ]
}
