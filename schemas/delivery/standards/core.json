{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/standards/core.json",
  "title": "Delivery Core Standard",
  "description": "Core standard defining minimal universal events for delivery tracking. Optional baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "events"],
  "properties": {
    "name": {
      "type": "string",
      "const": "xyz.localprotocol.delivery.core"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)."
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "active", "completed", "failed"],
      "properties": {
        "pending": {
          "$ref": "#/$defs/event"
        },
        "active": {
          "$ref": "#/$defs/event"
        },
        "completed": {
          "$ref": "#/$defs/event"
        },
        "failed": {
          "$ref": "#/$defs/event"
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event."
        }
      }
    },
    "instance": {
      "title": "Delivery Core Standard Instance",
      "description": "An instance of the core standard with event definitions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "xyz.localprotocol.delivery.core"
        },
        "version": {
          "const": "1.0.0"
        },
        "events": {
          "type": "object",
          "properties": {
            "pending": {
              "type": "object",
              "properties": {
                "description": { "const": "Job accepted, work not started" }
              }
            },
            "active": {
              "type": "object",
              "properties": {
                "description": { "const": "Work in progress" }
              }
            },
            "completed": {
              "type": "object",
              "properties": {
                "description": { "const": "Successfully finished" }
              }
            },
            "failed": {
              "type": "object",
              "properties": {
                "description": { "const": "Unsuccessfully finished" }
              }
            }
          }
        }
      }
    }
  }
}
