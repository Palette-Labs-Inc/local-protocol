{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/standards/food.json",
  "title": "Food Delivery Standard",
  "description": "Industry standard defining event vocabulary for restaurant and food delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "protocol", "title", "events"],
  "properties": {
    "name": {
      "type": "string",
      "const": "xyz.localprotocol.delivery.food"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)."
    },
    "protocol": {
      "type": "string",
      "pattern": "^xyz\\.localprotocol\\.delivery\\.core@\\d+\\.\\d+\\.\\d+$",
      "description": "Reference to core protocol version (e.g., xyz.localprotocol.delivery.core@1.0.0)."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the standard."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the standard."
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "URL to human-readable specification document."
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/event"
      },
      "description": "Map of event IDs to event definitions."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event."
        }
      }
    },
    "instance": {
      "title": "Food Delivery Standard Instance",
      "description": "An instance of the food delivery standard with event definitions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "xyz.localprotocol.delivery.food"
        },
        "version": {
          "const": "1.0.0"
        },
        "protocol": {
          "const": "xyz.localprotocol.delivery.core@1.0.0"
        },
        "title": {
          "const": "Food Delivery Standard"
        },
        "description": {
          "const": "Event vocabulary for restaurant and food delivery."
        },
        "spec": {
          "const": "https://localprotocol.xyz/spec/delivery/food"
        },
        "events": {
          "type": "object",
          "properties": {
            "order_placed": {
              "type": "object",
              "properties": {
                "description": { "const": "Order received by merchant" }
              }
            },
            "preparing": {
              "type": "object",
              "properties": {
                "description": { "const": "Merchant preparing order" }
              }
            },
            "ready_for_pickup": {
              "type": "object",
              "properties": {
                "description": { "const": "Order ready, awaiting courier" }
              }
            },
            "courier_assigned": {
              "type": "object",
              "properties": {
                "description": { "const": "Courier assigned to delivery" }
              }
            },
            "courier_at_pickup": {
              "type": "object",
              "properties": {
                "description": { "const": "Courier arrived at merchant" }
              }
            },
            "picked_up": {
              "type": "object",
              "properties": {
                "description": { "const": "Courier collected order" }
              }
            },
            "in_transit": {
              "type": "object",
              "properties": {
                "description": { "const": "Courier en route to customer" }
              }
            },
            "courier_at_dropoff": {
              "type": "object",
              "properties": {
                "description": { "const": "Courier arrived at customer" }
              }
            },
            "delivered": {
              "type": "object",
              "properties": {
                "description": { "const": "Order delivered to customer" }
              }
            },
            "canceled": {
              "type": "object",
              "properties": {
                "description": { "const": "Delivery canceled" }
              }
            },
            "failed": {
              "type": "object",
              "properties": {
                "description": { "const": "Delivery attempt unsuccessful" }
              }
            }
          }
        }
      }
    }
  }
}
