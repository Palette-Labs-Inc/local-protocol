{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/standards/food.json",
  "title": "Food Delivery Standard",
  "description": "Industry standard defining event vocabulary for restaurant and food delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "extends", "title", "events"],
  "properties": {
    "name": {
      "type": "string",
      "const": "xyz.localprotocol.delivery.food"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)."
    },
    "extends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "xyz.localprotocol.delivery.core@1.0.0"
      },
      "description": "Parent standard this extends (lineage and discovery). The reference must include a semver version."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the standard."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the standard."
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "URL to human-readable specification document."
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "active",
        "completed",
        "failed",
        "order_placed",
        "preparing",
        "ready_for_pickup",
        "courier_assigned",
        "courier_at_pickup",
        "picked_up",
        "in_transit",
        "courier_at_dropoff",
        "delivered",
        "canceled"
      ],
      "properties": {
        "pending": { "$ref": "#/$defs/event" },
        "active": { "$ref": "#/$defs/event" },
        "completed": { "$ref": "#/$defs/event" },
        "failed": { "$ref": "#/$defs/event" },
        "order_placed": { "$ref": "#/$defs/event" },
        "preparing": { "$ref": "#/$defs/event" },
        "ready_for_pickup": { "$ref": "#/$defs/event" },
        "courier_assigned": { "$ref": "#/$defs/event" },
        "courier_at_pickup": { "$ref": "#/$defs/event" },
        "picked_up": { "$ref": "#/$defs/event" },
        "in_transit": { "$ref": "#/$defs/event" },
        "courier_at_dropoff": { "$ref": "#/$defs/event" },
        "delivered": { "$ref": "#/$defs/event" },
        "canceled": { "$ref": "#/$defs/event" }
      },
      "description": "Map of all event IDs supported by this standard, including inherited events."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event."
        }
      }
    }
  }
}
