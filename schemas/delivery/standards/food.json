{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/standards/food.json",
  "title": "Food Delivery Standard",
  "description": "Industry standard defining event vocabulary for restaurant and food delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "extends", "title", "events"],
  "properties": {
    "name": {
      "type": "string",
      "const": "xyz.localprotocol.delivery.food"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)."
    },
    "extends": {
      "type": "string",
      "pattern": "^xyz\\.localprotocol\\.delivery\\.core@\\d+\\.\\d+\\.\\d+$",
      "description": "Parent standard this extends (e.g., xyz.localprotocol.delivery.core@1.0.0)."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the standard."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the standard."
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "URL to human-readable specification document."
    },
    "events": {
      "type": "object",
      "required": ["pending", "active", "completed", "failed"],
      "additionalProperties": {
        "$ref": "#/$defs/event"
      },
      "properties": {
        "pending": { "$ref": "#/$defs/event" },
        "active": { "$ref": "#/$defs/event" },
        "completed": { "$ref": "#/$defs/event" },
        "failed": { "$ref": "#/$defs/event" }
      },
      "description": "Map of event IDs to event definitions. Must include core events (pending, active, completed, failed)."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event."
        }
      }
    }
  }
}
