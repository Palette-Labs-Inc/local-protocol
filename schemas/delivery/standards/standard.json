{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/standards/standard.json",
  "title": "Delivery Event Standard",
  "description": "Schema for delivery event standards.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "title", "events"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "description": "Standard identifier in reverse-domain notation (e.g., xyz.localprotocol.delivery.food)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)."
    },
    "extends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@\\d+\\.\\d+\\.\\d+$",
        "description": "Standard reference with semver (e.g., xyz.localprotocol.delivery.core@1.0.0)."
      },
      "description": "Parent standard this standard extends (optional). Only one parent is allowed; the reference must include a semver version. Used for lineage and discovery."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the standard."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the standard."
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "URL to human-readable specification document."
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/event"
      },
      "description": "Map of all event IDs supported by this standard, including inherited events."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event."
        }
      }
    }
  }
}
