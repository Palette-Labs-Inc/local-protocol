{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/delivery/delivery.json",
  "title": "Delivery",
  "description": "Delivery resource created when a quote is accepted.",
  "type": "object",
  "required": ["id", "request_id", "quote_id", "payment_instrument_id", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique delivery identifier."
    },
    "request_id": {
      "type": "string",
      "description": "Reference to the original request."
    },
    "quote_id": {
      "type": "string",
      "description": "Reference to the accepted quote."
    },
    "payment_instrument_id": {
      "type": "string",
      "description": "Reference to the payment instrument used to create this delivery."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Delivery creation timestamp (RFC 3339)."
    }
  },
  "additionalProperties": false
}
