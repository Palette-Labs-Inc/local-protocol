{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/commerce/restaurant.json",
  "title": "Restaurant",
  "description": "Restaurant catalog payload containing canonical objects and menu views.",
  "type": "object",
  "required": [
    "id",
    "name",
    "timezone",
    "catalogs",
    "categories",
    "items",
    "modifier_groups",
    "modifier_options",
    "modifier_items",
    "menu_views"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Restaurant identifier."
    },
    "name": {
      "type": "string",
      "description": "Restaurant name."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone for availability schedules."
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp of the latest catalog update."
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "catalog.json"
      },
      "description": "Catalogs available for the restaurant."
    },
    "menu_views": {
      "type": "array",
      "items": {
        "$ref": "menu_view.json"
      },
      "description": "Presentation menu trees for catalogs."
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "types/category.json"
      },
      "description": "Canonical catalog categories."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "types/item.json"
      },
      "description": "Canonical catalog items."
    },
    "modifier_groups": {
      "type": "array",
      "items": {
        "$ref": "types/modifier_group.json"
      },
      "description": "Canonical modifier groups."
    },
    "modifier_options": {
      "type": "array",
      "items": {
        "$ref": "types/modifier_option.json"
      },
      "description": "Canonical modifier options."
    },
    "modifier_items": {
      "type": "array",
      "items": {
        "$ref": "types/modifier_item.json"
      },
      "description": "Canonical modifier items."
    },
    "external_ids": {
      "type": "array",
      "items": {
        "$ref": "types/external_id.json"
      },
      "description": "Provider identifiers for this restaurant."
    },
    "metadata": {
      "type": "object",
      "description": "Business-defined custom data extending the restaurant.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
