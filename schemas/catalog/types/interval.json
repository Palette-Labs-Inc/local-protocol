{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/catalog/types/interval.json",
  "title": "Interval",
  "description": "A single time interval for a day of the week or a specific date.",
  "type": "object",
  "required": [
    "from_hour",
    "from_minute",
    "to_hour",
    "to_minute"
  ],
  "properties": {
    "day": {
      "type": "string",
      "description": "Day of week (e.g., Monday, Tuesday)."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Calendar date in YYYY-MM-DD."
    },
    "from_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "description": "Start hour (0-23)."
    },
    "from_minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59,
      "description": "Start minute (0-59)."
    },
    "to_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "description": "End hour (0-23)."
    },
    "to_minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59,
      "description": "End minute (0-59)."
    }
  },
  "oneOf": [
    {
      "required": [
        "day"
      ],
      "not": {
        "required": [
          "date"
        ]
      }
    },
    {
      "required": [
        "date"
      ],
      "not": {
        "required": [
          "day"
        ]
      }
    }
  ],
  "additionalProperties": false
}
