{
    "name": "localprotocol/local-protocol-sdk",
    "version": "0.1.0",
    "description": "Local Protocol delivery API. Covers service discovery, delivery requests, quotes, and deliveries.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://openapi-generator.tech",
    "license": "unlicense",
    "authors": [
        {
            "name": "OpenAPI",
            "homepage": "https://openapi-generator.tech"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "LocalProtocolSdk\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "LocalProtocolSdk\\Test\\" : "test/" }
