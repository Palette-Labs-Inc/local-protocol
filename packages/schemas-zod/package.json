{
  "name": "@local-protocol/schemas-zod",
  "version": "0.0.1",
  "description": "Zod schema definitions that generate JSON Schema identical to local-protocol/schemas via z.toJSONSchema()",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "node dist/generate.js",
    "generate:schemas": "yarn build && yarn generate"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
