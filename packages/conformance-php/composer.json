{
  "name": "local-protocol/conformance-php",
  "description": "PHP conformance tests for Local Protocol servers",
  "type": "project",
  "license": "Apache-2.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "local-protocol/local-protocol": "*",
    "symfony/http-client": "^7",
    "nyholm/psr7": "^1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../sdks/local-protocol-php"
    }
  ],
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
