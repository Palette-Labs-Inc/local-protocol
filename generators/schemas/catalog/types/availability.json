{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/catalog/types/availability.json",
  "title": "Availability",
  "description": "Availability schedule for a catalog, category, or item.",
  "type": "object",
  "required": [
    "intervals"
  ],
  "properties": {
    "timezone": {
      "type": "string",
      "description": "IANA timezone for the intervals. Defaults to the merchant timezone when omitted."
    },
    "intervals": {
      "type": "array",
      "description": "Availability intervals (weekly or date-specific).",
      "items": {
        "$ref": "interval.json"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
