{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/catalog/types/interval.json",
  "title": "Interval",
  "description": "A single time interval for a day of the week or a specific date.",
  "type": "object",
  "required": [
    "from_hour",
    "from_minute",
    "to_hour",
    "to_minute"
  ],
  "properties": {
    "day": {
      "type": "string",
      "description": "Day of week (e.g., Monday, Tuesday)."
    },
    "date": {
      "type": "string",
      "description": "Calendar date in YYYY-MM-DD."
    },
    "from_hour": {
      "type": "integer",
      "description": "Start hour (0-23).",
      "minimum": 0,
      "maximum": 23
    },
    "from_minute": {
      "type": "integer",
      "description": "Start minute (0-59).",
      "minimum": 0,
      "maximum": 59
    },
    "to_hour": {
      "type": "integer",
      "description": "End hour (0-23).",
      "minimum": 0,
      "maximum": 23
    },
    "to_minute": {
      "type": "integer",
      "description": "End minute (0-59).",
      "minimum": 0,
      "maximum": 59
    }
  },
  "additionalProperties": false
}
