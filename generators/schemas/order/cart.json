{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique cart identifier."
    },
    "intent_id": {
      "type": "string",
      "description": "Shared intent identifier for tracing Request → Quote → Order."
    },
    "nonce": {
      "type": "string",
      "description": "Client-generated idempotency key."
    },
    "items": {
      "type": "array",
      "description": "Items in the cart.",
      "items": {
        "$ref": "types/cart_item.json"
      }
    }
  },
  "required": [
    "id",
    "intent_id",
    "nonce",
    "items"
  ]
}
