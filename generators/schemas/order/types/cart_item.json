{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cart Item",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Item identifier."
    },
    "quantity": {
      "type": "integer",
      "description": "Quantity requested.",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "quantity"
  ]
}
