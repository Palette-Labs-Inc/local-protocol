{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/shared/evm_currency.json",
  "title": "EvmCurrency",
  "description": "EVM token currency descriptor.",
  "type": "object",
  "required": [
    "chain_id",
    "address",
    "decimals"
  ],
  "properties": {
    "chain_id": {
      "type": "integer",
      "description": "EVM chain id.",
      "minimum": 1
    },
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Token contract address."
    },
    "decimals": {
      "type": "integer",
      "description": "Decimal places for the token.",
      "minimum": 0,
      "maximum": 255
    }
  },
  "additionalProperties": false
}
