{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/shared/fiat_currency.json",
  "title": "FiatCurrency",
  "description": "Fiat currency descriptor.",
  "type": "object",
  "required": [
    "symbol"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "description": "ISO 4217 currency code (e.g., 'USD', 'EUR', 'JPY')."
    }
  },
  "additionalProperties": false
}
