{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localprotocol.xyz/schemas/shared/media.json",
  "title": "Media",
  "description": "Product media item (image, video, etc.).",
  "type": "object",
  "required": [
    "type",
    "url"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "Media type discriminator.",
      "enum": [
        "image",
        "video",
        "model_3d"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the media resource."
    },
    "alt_text": {
      "type": "string",
      "description": "Accessibility text describing the media."
    },
    "width": {
      "type": "integer",
      "description": "Width in pixels (for images/video).",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "description": "Height in pixels (for images/video).",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
