{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique request identifier."
    },
    "nonce": {
      "type": "string",
      "description": "Client-generated idempotency key."
    },
    "pickup_location": {
      "$ref": "types/location.json",
      "description": "Pickup location for the delivery."
    },
    "dropoff_location": {
      "$ref": "types/location.json",
      "description": "Dropoff location for the delivery."
    },
    "pickup_time": {
      "type": "string",
      "format": "date-time",
      "description": "Requested pickup time (RFC 3339)."
    },
    "dropoff_time": {
      "type": "string",
      "format": "date-time",
      "description": "Requested dropoff time (RFC 3339)."
    },
    "pickup_instructions": {
      "type": "string",
      "description": "Pickup directions, access codes, or handling notes."
    },
    "dropoff_instructions": {
      "type": "string",
      "description": "Dropoff directions, access codes, or delivery notes."
    }
  },
  "required": [
    "id",
    "nonce",
    "pickup_location",
    "dropoff_location",
    "pickup_time",
    "dropoff_time"
  ]
}
